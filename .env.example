# ---------------------------------------------------------------------------------------------------------
# Discord
# @see https://discord.com/developers/applications
# ---------------------------------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_OWNER_ID=your_discord_owner_id_here
# Optional: guild to deploy commands to on bot join
DISCORD_DEFAULT_GUILD_ID=your_discord_default_guild_id_here
# Optional: channel ID to post join/leave server notifications
DISCORD_LOGS_CHANNEL_ID=your_discord_logs_channel_id_here

# ---------------------------------------------------------------------------------------------------------
# AI
# AI Services used for chatting and other functionalities.
# You can configure which provider you'd like to use, in the src/lib/ai/providers.ts file.
# @see https://ai-sdk.dev/docs/foundations/providers-and-models
# ---------------------------------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# HACKCLUB_API_KEY=your_hackclub_api_key_here

# ---------------------------------------------------------------------------------------------------------
# Memory
# Pinecone vector store for long-term memory.
# Index spec: dense, 1536-dim, dotproduct, aws us-east-1, namespace "default"
# @see https://pinecone.io/
# ---------------------------------------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name_here

# ---------------------------------------------------------------------------------------------------------
# Redis
# Used for rate limiting, response modes, and silence state.
# Docker Compose provides Redis automatically, only set this for external Redis.
# ---------------------------------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------------------------------------
# Voice
# Deepgram for speech-to-text in voice channels.
# @see https://deepgram.com/
# ---------------------------------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ---------------------------------------------------------------------------------------------------------
# Search
# @see https://exa.ai/
# ---------------------------------------------------------------------------------------------------------
EXA_API_KEY=your_exa_api_key_here

# ---------------------------------------------------------------------------------------------------------
# Logging
# LOG_LEVEL: debug | info | warn | error
# ---------------------------------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIRECTORY=logs

# ---------------------------------------------------------------------------------------------------------
# Observability
# @see https://langfuse.com/
# ---------------------------------------------------------------------------------------------------------
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASEURL="https://cloud.langfuse.com" # use "https://us.cloud.langfuse.com" for US region

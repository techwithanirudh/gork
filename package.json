{
  "name": "discord-ai-bot",
  "version": "1.0.0",
  "description": "An AI-powered Discord bot built using Bun, TypeScript and ESLint.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/techwithanirudh/discord-ai-bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/techwithanirudh/discord-ai-bot.git"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "format": "prettier --cache --write --list-different --ignore-path .gitignore --ignore-path .prettierignore .",
    "format:check": "prettier --cache --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "deploy": "bun run src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun lint && bun typecheck && bun format:check && bun check:spelling",
    "check:spelling": "cspell -c .cspell.json --no-progress --no-summary --no-must-find-files --unique",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^3.0.30",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@cspell/dict-bash": "^4.2.2",
    "@cspell/dict-redis": "^1.0.7",
    "@date-fns/tz": "^1.4.1",
    "@deepgram/sdk": "^4.11.3",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@elevenlabs/elevenlabs-js": "^2.43.0",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^2.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@snazzah/davey": "^0.1.11",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/functions": "^3.4.3",
    "@vercel/otel": "^2.1.2",
    "ai": "^6.0.168",
    "ai-retry": "^1.5.0",
    "compromise": "^14.15.0",
    "cspell": "^10.0.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exa-js": "^2.11.0",
    "ffmpeg-static": "^5.3.0",
    "fuse.js": "^7.3.0",
    "jsonrepair": "^3.14.0",
    "langfuse-vercel": "^3.38.20",
    "libsodium-wrappers": "^0.8.4",
    "lint-staged": "^16.4.0",
    "node-crc": "^4.0.0",
    "opusscript": "^0.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prism-media": "^1.3.5",
    "redis": "^5.12.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{cjs,mjs,js,jsx,cts,mts,ts,tsx,json}": "eslint --fix .",
    "**/*": [
      "prettier --write --ignore-unknown",
      "bun check:spelling"
    ]
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "esbuild",
    "ffmpeg-static",
    "lefthook",
    "node-crc",
    "unrs-resolver"
  ]
}
